export ZSH="$HOME/.oh-my-zsh"
export XDG_CONFIG_HOME="$HOME/.config"

{{- if eq .chezmoi.os "darwin" }}
# Homebrew is installed in /opt/homebrew on Apple Silicon Macs.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
{{- else if eq .chezmoi.os "linux" }}
# Add Linuxbrew when it is installed; this is harmless on apt-only systems.
[ -d "/home/linuxbrew/.linuxbrew/bin" ] && export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
{{- end }}

ZSH_THEME="robbyrussell"
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-bat
  conda
)

source "$ZSH/oh-my-zsh.sh"

if command -v conda >/dev/null 2>&1; then
  __conda_setup="$(conda shell.zsh hook 2>/dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  fi
  unset __conda_setup
fi

[ -d "$HOME/.lmstudio/bin" ] && export PATH="$PATH:$HOME/.lmstudio/bin"
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
[ -d "$HOME/.antigravity/antigravity/bin" ] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ] && export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"

{{- if eq .chezmoi.os "darwin" }}
[ -d "/opt/homebrew/opt/node@22/bin" ] && export PATH="/opt/homebrew/opt/node@22/bin:$PATH"
{{- end }}

gif() {
  ffmpeg -i "$1" -lavfi "fps=15,scale=720:-1:flags=lanczos,split[s0][s1];[s0]palettegen=stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=5" -y "${2:-output.gif}"
}

# Keep credentials in an untracked, per-machine file.
[ -f "$XDG_CONFIG_HOME/secrets.env" ] && source "$XDG_CONFIG_HOME/secrets.env"

# pi: shell-command suggestions (Ctrl+L) — single-output, non-interactive
_pi_zsh() {
  if [[ -n "$BUFFER" ]]; then
    local _prev=$BUFFER
    BUFFER+="⌛"
    zle -I && zle redisplay
    local _out
    _out=$(command pi -p --no-session --no-tools --system-prompt 'You are a shell command generator. Given the user request, output ONLY the single shell command that fulfils it, with no explanation, no markdown, no code fences. If the request is already a shell command, improve or correct it.' -- "$_prev" 2>/dev/null)
    # strip markdown fences if present and trim whitespace
    _out=$(printf '%s' "$_out" | sed -e 's/^```[a-zA-Z0-9_-]*$//' -e 's/^```//' -e 's/```$//' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    if [[ -n "$_out" ]]; then
      BUFFER=$_out
    else
      BUFFER=$_prev
    fi
    zle end-of-line
  fi
}
zle -N _pi_zsh
bindkey ^l _pi_zsh
